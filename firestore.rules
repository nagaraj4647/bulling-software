rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /businesses/{businessId} {

      allow create:
        if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;

      allow read:
        if request.auth != null
        && resource.data.ownerId == request.auth.uid;

      allow update:
        if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly([
          'ownerId', 'businessName', 'businessType', 'ownerName', 'phone',
          'email', 'address', 'businessState', 'gstNumber', 'isGstInclusive',
          'logoUrl', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.businessName is string && request.resource.data.businessName.size() > 0
        && request.resource.data.businessType is string && request.resource.data.businessType.size() > 0
        && request.resource.data.ownerName is string && request.resource.data.ownerName.size() > 0
        && request.resource.data.phone is string && request.resource.data.phone.size() > 0
        && request.resource.data.email is string && request.resource.data.email.size() > 0
        && request.resource.data.address is string && request.resource.data.address.size() > 0
        && request.resource.data.isGstInclusive is bool
        && request.resource.data.updatedAt is timestamp;

      allow delete: if false;

      match /products/{productId} {
        allow read, create, delete:
          if request.auth != null
          && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
        
        allow update:
          if request.auth != null
          && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid
          && (request.resource.data.stockQuantity is number && request.resource.data.stockQuantity >= 0);
      }

      match /inventoryTransactions/{transactionId} {
        allow read, create:
          if request.auth != null
          && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
        // Deny update and delete for inventory history
        allow update, delete: if false;
      }

      match /customers/{customerId} {
        allow read:
          if request.auth != null
          && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;

        // CREATE: strict shape validation
        allow create:
          if request.auth != null
          && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'customerId', 'businessId', 'name', 'phone', 'alternatePhone',
            'email', 'address', 'city', 'state', 'pincode', 'gstNumber',
            'openingBalance', 'outstandingBalance', 'creditLimit', 'notes',
            'isActive', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.customerId == customerId
          && request.resource.data.businessId == businessId
          && request.resource.data.name is string && request.resource.data.name.size() > 0
          && request.resource.data.openingBalance is number
          && request.resource.data.outstandingBalance is number
          && request.resource.data.outstandingBalance == request.resource.data.openingBalance
          && request.resource.data.creditLimit is number
          && request.resource.data.isActive == true;

        // UPDATE: immutable fields protected, controlled balance updates
        allow update:
          if request.auth != null
          && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'customerId', 'businessId', 'name', 'phone', 'alternatePhone',
            'email', 'address', 'city', 'state', 'pincode', 'gstNumber',
            'openingBalance', 'outstandingBalance', 'creditLimit', 'notes',
            'isActive', 'createdAt', 'updatedAt'
          ])
          // Immutable fields must not change
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.businessId == resource.data.businessId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.openingBalance == resource.data.openingBalance
          && (
            // Case 1: Normal profile update — outstandingBalance must remain unchanged
            (request.resource.data.outstandingBalance == resource.data.outstandingBalance)
            ||
            // Case 2: Transaction balance update (from Billing confirm/cancel) —
            // only outstandingBalance and updatedAt may differ from existing document
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['outstandingBalance', 'updatedAt'])
             && request.resource.data.outstandingBalance is number)
          );

        allow delete: if false;
      }

      match /invoices/{invoiceId} {
        allow read:
          if request.auth != null
          && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;

        // CREATE: drafts only, strict field whitelist
        allow create:
          if request.auth != null
          && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'invoiceId', 'businessId', 'invoiceNumber', 'issueDate',
            'customerSnapshot', 'items', 'subtotal', 'discountAmount',
            'taxableAmount', 'cgstTotal', 'sgstTotal', 'igstTotal',
            'grandTotal', 'payment', 'status', 'notes', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.businessId == businessId
          && request.resource.data.status == 'draft'
          && request.resource.data.invoiceNumber == ''
          && request.resource.data.grandTotal is number;

        // UPDATE: controlled transitions with field whitelist
        allow update:
          if request.auth != null
          && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'invoiceId', 'businessId', 'invoiceNumber', 'issueDate',
            'customerSnapshot', 'items', 'subtotal', 'discountAmount',
            'taxableAmount', 'cgstTotal', 'sgstTotal', 'igstTotal',
            'grandTotal', 'payment', 'status', 'notes', 'createdAt', 'updatedAt'
          ])
          && (
            // T1: draft → draft (edit draft)
            (resource.data.status == 'draft'
             && request.resource.data.status == 'draft'
             && request.resource.data.businessId == resource.data.businessId
             && request.resource.data.invoiceNumber == ''
             && request.resource.data.createdAt == resource.data.createdAt
             && (!('invoiceId' in resource.data) || !('invoiceId' in request.resource.data) || request.resource.data.invoiceId == resource.data.invoiceId)
             && request.resource.data.grandTotal is number)
            ||
            // T2: draft → confirmed (authoritative confirmation with INV-###### number)
            (resource.data.status == 'draft'
             && request.resource.data.status == 'confirmed'
             && request.resource.data.invoiceNumber.matches('^INV-\\d{6}$')
             && request.resource.data.businessId == resource.data.businessId
             && request.resource.data.createdAt == resource.data.createdAt
             && (!('invoiceId' in resource.data) || !('invoiceId' in request.resource.data) || request.resource.data.invoiceId == resource.data.invoiceId)
             && request.resource.data.grandTotal is number)
            ||
            // T3: confirmed → cancelled (reversal: only status and updatedAt may change)
            (resource.data.status == 'confirmed'
             && request.resource.data.status == 'cancelled'
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
            ||
            // T4: draft → cancelled (abandon draft: only status and updatedAt may change)
            (resource.data.status == 'draft'
             && request.resource.data.status == 'cancelled'
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
          );

        allow delete: if false;
      }

      match /suppliers/{supplierId} {
        allow read: 
          if request.auth != null 
          && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;

        allow create: 
          if request.auth != null 
          && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid
          && request.resource.data.businessId == businessId
          && request.resource.data.supplierId == supplierId
          && request.resource.data.openingBalance is number && request.resource.data.openingBalance >= 0
          && request.resource.data.outstandingBalance is number && request.resource.data.outstandingBalance >= 0
          && request.resource.data.outstandingBalance == request.resource.data.openingBalance
          && request.resource.data.supplierCode.matches('^SUP-\\d{6}$')
          && request.resource.data.isActive == true;
          
        allow update: 
          if request.auth != null 
          && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'supplierId', 'businessId', 'supplierCode', 'name', 'phone', 
            'email', 'address', 'city', 'state', 'pincode', 'gstNumber', 
            'searchKeywords', 'openingBalance', 'outstandingBalance', 
            'isActive', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.businessId == resource.data.businessId
          && request.resource.data.supplierId == resource.data.supplierId
          && request.resource.data.supplierCode == resource.data.supplierCode
          && request.resource.data.openingBalance == resource.data.openingBalance
          && request.resource.data.outstandingBalance is number;
          
        allow delete: if false; 
      }

      match /purchases/{purchaseId} {
        allow read:
          if request.auth != null
          && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;

        // CREATE: drafts only, strict shape validation
        allow create:
          if request.auth != null
          && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'purchaseId', 'businessId', 'purchaseNumber', 'purchaseDate',
            'supplierSnapshot', 'items', 'subtotal', 'discountAmount',
            'taxableAmount', 'cgstTotal', 'sgstTotal', 'igstTotal',
            'grandTotal', 'payment', 'settledAmount', 'status',
            'notes', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.businessId == businessId
          && request.resource.data.purchaseId == purchaseId
          && request.resource.data.status == 'draft'
          && request.resource.data.purchaseNumber == ''
          && request.resource.data.grandTotal is number
          && request.resource.data.settledAmount is number
          && request.resource.data.settledAmount == 0;

        // UPDATE: four controlled transitions, field whitelist on every transition
        allow update:
          if request.auth != null
          && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'purchaseId', 'businessId', 'purchaseNumber', 'purchaseDate',
            'supplierSnapshot', 'items', 'subtotal', 'discountAmount',
            'taxableAmount', 'cgstTotal', 'sgstTotal', 'igstTotal',
            'grandTotal', 'payment', 'settledAmount', 'status',
            'notes', 'createdAt', 'updatedAt'
          ])
          && (
            // T1: draft → draft (edit draft)
            (resource.data.status == 'draft'
             && request.resource.data.status == 'draft'
             && request.resource.data.purchaseId == resource.data.purchaseId
             && request.resource.data.businessId == resource.data.businessId
             && request.resource.data.purchaseNumber == ''
             && request.resource.data.createdAt == resource.data.createdAt
             && request.resource.data.settledAmount == 0
             && request.resource.data.grandTotal is number)
            ||
            // T2: draft → confirmed (authoritative snapshot rebuild)
            (resource.data.status == 'draft'
             && request.resource.data.status == 'confirmed'
             && request.resource.data.purchaseNumber.matches('^PUR-\\d{6}$')
             && request.resource.data.purchaseId == resource.data.purchaseId
             && request.resource.data.businessId == resource.data.businessId
             && request.resource.data.createdAt == resource.data.createdAt
             && request.resource.data.settledAmount == 0
             && request.resource.data.grandTotal is number)
            ||
            // T3: confirmed → cancelled (accounting-safe reversal)
            (resource.data.status == 'confirmed'
             && resource.data.settledAmount == 0
             && request.resource.data.status == 'cancelled'
             && request.resource.data.settledAmount == 0
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
            ||
            // T4: draft → cancelled (abandon draft, no side effects)
            (resource.data.status == 'draft'
             && request.resource.data.status == 'cancelled'
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
          );

        allow delete: if false;
      }

      match /expenses/{expenseId} {
        allow read:
          if request.auth != null
          && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;

        // CREATE: drafts only, strict shape validation
        allow create:
          if request.auth != null
          && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'expenseId', 'businessId', 'expenseDate', 'category',
            'description', 'amount', 'paymentMethod', 'notes',
            'status', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.businessId == businessId
          && request.resource.data.expenseId == expenseId
          && request.resource.data.status == 'draft'
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.expenseDate is timestamp;

        // UPDATE: controlled transitions, field whitelist on every transition
        allow update:
          if request.auth != null
          && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'expenseId', 'businessId', 'expenseDate', 'category',
            'description', 'amount', 'paymentMethod', 'notes',
            'status', 'createdAt', 'updatedAt'
          ])
          && (
            // T1: draft → draft (edit draft)
            (resource.data.status == 'draft'
             && request.resource.data.status == 'draft'
             && request.resource.data.expenseId == resource.data.expenseId
             && request.resource.data.businessId == resource.data.businessId
             && request.resource.data.createdAt == resource.data.createdAt
             && request.resource.data.amount is number
             && request.resource.data.amount > 0
             && request.resource.data.expenseDate is timestamp)
            ||
            // T2: draft → confirmed
            (resource.data.status == 'draft'
             && request.resource.data.status == 'confirmed'
             && request.resource.data.expenseId == resource.data.expenseId
             && request.resource.data.businessId == resource.data.businessId
             && request.resource.data.createdAt == resource.data.createdAt
             // Ensure financial fields haven't changed from what they were when draft was read (prevent bypass)
             && request.resource.data.amount == resource.data.amount
             && request.resource.data.category == resource.data.category
             && request.resource.data.expenseDate == resource.data.expenseDate
             && request.resource.data.paymentMethod == resource.data.paymentMethod
             && request.resource.data.description == resource.data.description)
            ||
            // T3: confirmed → cancelled (only status and updatedAt can change)
            (resource.data.status == 'confirmed'
             && request.resource.data.status == 'cancelled'
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
            ||
            // T4: draft → cancelled
            (resource.data.status == 'draft'
             && request.resource.data.status == 'cancelled'
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
          );

        allow delete: if false;
      }

      match /metadata/counters {
        allow read, write:
          if request.auth != null
          && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
      }
    }
  }
}
